# --- Server ---
NODE_ENV=development
PORT=5000

# --- MongoDB ---
# Local:  mongodb://127.0.0.1:27017/activa
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/activa?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/activa

# --- CORS ---
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Rate limiting for POST /api/demo-requests (per IP) ---
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=10

# Number of reverse proxies in front of the API (e.g. 1 behind Nginx/Render/Railway). 0 = none.
TRUST_PROXY=0

# Serve the built frontend (../frontend/dist) from this server: true | false
SERVE_FRONTEND=false
