# Server
NODE_ENV=development
PORT=5000

# SMTP email credentials (use your provider's SMTP details)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Email delivery
MAIL_FROM=
DEMO_RECIPIENT_EMAIL=

# CORS: comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Rate limiting for demo submissions (per IP)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=10

# Number of reverse proxies in front of the API (e.g. 1 behind Nginx). 0 = none.
TRUST_PROXY=0

# Serve the built frontend from ../frontend/dist: true | false
SERVE_FRONTEND=false
